# --- Neon (serverless Postgres) ---------------------------------------------
# Connection string from your Neon project dashboard. When set, users and the
# leaderboard are persisted to Neon (in `npm run dev` and on Vercel). Leave it
# unset to use the in-memory / localStorage fallback.
DATABASE_URL=

# --- Solana ------------------------------------------------------------------
# RPC endpoint and cluster used to read wallet balances (client-side).
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_CLUSTER=devnet

# --- API ---------------------------------------------------------------------
# Override the API URLs (e.g. point a static GitHub Pages build at a Vercel
# deployment). Default to the same-origin /api/leaderboard and /api/users.
# VITE_API_URL=https://your-app.vercel.app/api/leaderboard
# VITE_USERS_API_URL=https://your-app.vercel.app/api/users
