# Copia este archivo a .env.local y rellena el valor.
# .env.local está en .gitignore y NO se sube al repo.

# URL del Worker proxy de Meshy (Cloudflare). El frontend habla con este proxy,
# nunca con api.meshy.ai directamente, para no exponer la API key.
VITE_MESHY_PROXY_URL=https://meshy-proxy.tu-subdominio.workers.dev

# NOTA: la MESHY_API_KEY (msy_...) NO va aquí ni en el frontend.
# Se guarda como secret en el Worker:  npx wrangler secret put MESHY_API_KEY
