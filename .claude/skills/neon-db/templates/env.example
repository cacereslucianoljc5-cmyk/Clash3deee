# Copiá este archivo a .env.local y completá el valor real.
# .env.local está en .gitignore y NUNCA se sube al repositorio.
#
# DATABASE_URL: cadena de conexión de tu base Neon.
# Neon Console → tu proyecto → Connect → "Connection string".
# Usá la variante "Pooled connection" (el host incluye "-pooler").
#
# Ejemplo (NO es real):
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL=
